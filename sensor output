//light sensor base code to be printed into the terminal to see outputs to be scaled//

import time
import board
import adafruit_veml7700

# Initialize I2C and sensor
i2c = board.I2C()
sensor = adafruit_veml7700.VEML7700(i2c)

while True:
    print(f"Ambient light: {sensor.light:.2f} lux")
    time.sleep(0.5)

